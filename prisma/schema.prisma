generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String     @unique
  display_name     String
  avatar_url       String?
  bio              String?
  current_location String?
  home_country     String?
  roles            String[]   @default(["user"])
  preferences      Json?      @default("{}")
  created_at       DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?  @default(now()) @updatedAt @db.Timestamptz(6)
  comments         Comment[]
  favorites        Favorite[]
  pois             POI[]

  @@map("users")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model POI {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String
  latitude        Float
  longitude       Float
  category        String
  rating          Float?     @default(0)
  tags            String[]   @default([])
  metadata        Json?      @default("{}")
  photos          String[]   @default([])
  verified        Boolean?   @default(false)
  views_count     Int?       @default(0)
  favorites_count Int?       @default(0)
  region          String
  created_by      String?    @db.Uuid
  created_at      DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?  @default(now()) @updatedAt @db.Timestamptz(6)
  comments        Comment[]
  favorites       Favorite[]
  user            User?      @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category], map: "idx_pois_category")
  @@index([created_by], map: "idx_pois_created_by")
  @@index([region], map: "idx_pois_region")
  @@map("pois")
}

model Favorite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  poi_id     String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  poi        POI       @relation(fields: [poi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, poi_id])
  @@map("favorites")
}

model Comment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content    String
  poi_id     String    @db.Uuid
  user_id    String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  poi        POI       @relation(fields: [poi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("comments")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
