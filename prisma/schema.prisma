// Prisma Schema for OGT 3D Map Platform
// Database: PostgreSQL with PostGIS extension (via Supabase)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// User model (synced with Supabase Auth)
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  display_name  String
  avatar_url    String?
  bio           String?
  current_location String?
  home_country  String?
  roles         String[] @default(["user"])
  preferences   Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  pois          POI[]
  favorites     Favorite[]
  comments      Comment[]

  @@map("users")
}

// Point of Interest (POI) model
model POI {
  id              String   @id @default(uuid())
  name            String
  description     String
  latitude        Float
  longitude       Float
  category        String   // coworking, cafe, accommodation, restaurant, etc.
  rating          Float    @default(0)
  tags            String[]
  metadata        Json?    // hours, cost, website, amenities
  photos          String[] // Array of Supabase Storage URLs
  verified        Boolean  @default(false)
  views_count     Int      @default(0)
  favorites_count Int      @default(0)
  region          String   // lisbon, andalusia, etc.
  created_by      String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [created_by], references: [id], onDelete: Cascade)
  favorites       Favorite[]
  comments        Comment[]

  // Indexes for performance
  @@index([category])
  @@index([region])
  @@index([created_by])
  @@index([latitude, longitude])
  @@map("pois")
}

// User favorites
model Favorite {
  id         String   @id @default(uuid())
  user_id    String
  poi_id     String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  poi        POI      @relation(fields: [poi_id], references: [id], onDelete: Cascade)

  @@unique([user_id, poi_id])
  @@map("favorites")
}

// Comments/Reviews
model Comment {
  id         String   @id @default(uuid())
  poi_id     String
  user_id    String
  content    String
  rating     Float?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  poi        POI      @relation(fields: [poi_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([poi_id])
  @@index([user_id])
  @@map("comments")
}

// Region definitions
model Region {
  id          String   @id
  name        String
  bounds      Json     // { north, south, east, west }
  center      Json     // { lat, lon, altitude }
  zoom_level  Float
  tile_providers Json  // Cesium Ion asset IDs
  featured_pois String[]
  description String
  population  Int?
  timezone    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("regions")
}
